{
  "outputDirectory": ".site",
  "topicHierarchy": "directory",
  "topics": [
    "docs/**/*.md"
  ],
  "topicOrder": [
    "command-line",
    "configuration",
    "globe-patterns",
    "writing-documentation",
    "conceptual-topics",
    "documenting-namespaces",
    "xmldoc-tags",
    "best-practices",
    "url-resolution",
    "themes",
    "ci-cd-integration"
  ],
  "assets": [
    {
      "source": [
        "LICENSE",
        "*.png",
        "docs/*.png"
      ]
    },
    {
      "targetPath": "json-schemas",
      "source": [
        "resources/json-schema/**/*.json"
      ]
    }
  ],
  "theme": "classic",
  "themeSettings": {
    "projectName": "Kampose",
    "projectSlogan": "A tool to bring your code’s story to light.",
    "projectLogoLightUri": "logo-dark.png",
    "projectLogoDarkUri": "logo-light.png",
    "faviconUri": "ICON.png",
    "excludeLeftSidebar": true,
    "popupAssetNames": [
      "LICENSE",
      "*.json"
    ],
    "menuItems": [
      "*"
    ],
    "pageFooter": [
      "- Copyright © {{now 'yyyy'}} Kampute",
      "- [MIT License](~/LICENSE)",
      "- [Source code](https://github.com/kampute/kampose)"
    ],
    "pageFooterRight": [
      "Built with [Kampose](https://kampute.github.io/kampose/)"
    ]
  },
  "audit": {
    "verifyExternalLinks": false,
    "stopOnIssues": true
  }
}
