{{!--
  This partial renders a page layout.
  @param {object} this - The template context.
--}}

<!DOCTYPE html>
<html lang="en">

<head>
  {{>page_meta}}
</head>

<body class="{{#unless excludeLeftSidebar}}has-left-sidebar{{/unless}} {{#unless excludeRightSidebar}}has-right-sidebar{{/unless}} {{#if menuItems}}has-menu{{/if}} {{#unless excludeBreadcrumb}}has-breadcrumb{{/unless}}">
  <a href="#article" class="skip-link" aria-label="Skip to main content" tabindex="0">Skip to main content</a>

  <header class="header" role="banner">
    <div class="header-main">
      {{>brand}}
      <div class="header-tools" aria-label="Header tools">
        {{#unless excludeLeftSidebar}}
        <button id="mobile-nav-toggle" class="mobile-header-button" type="button" aria-label="Open API navigation" aria-controls="site-navigation-panel" aria-expanded="false">
          <span class="icon icon-api-reference" aria-hidden="true"></span>
        </button>
        {{/unless}}
        {{#if menuItems}}
        <button id="mobile-menu-toggle" class="mobile-header-button" type="button" aria-label="Open documentation topics" aria-controls="menubar" aria-expanded="false">
          <span class="icon icon-topics" aria-hidden="true"></span>
        </button>
        {{/if}}
        {{>color-mode}}
      </div>
    </div>
    {{#if menuItems}}
    {{>menubar}}
    {{/if}}
    {{#unless excludeBreadcrumb}}
    {{>breadcrumb}}
    {{/unless}}
  </header>

  <div class="content">
    {{#unless excludeLeftSidebar}}
    {{>sidebar_left}}
    {{/unless}}

    <main id="article" role="main" class="article {{#if expandMembers}}has-expanded-members{{/if}} {{#if model.category}}{{>member_class_names model}}{{/if}}">
      {{#if pageHeader}}
      <header class="content-header" role="banner">
        {{{>pageHeader_partial}}}
      </header>
      {{/if}}

      {{> (concat 'page_content_' pageType)}}

      {{#if (or pageFooter pageFooterRight)}}
      <footer class="content-footer" role="contentinfo">
        {{#if pageFooter}}<div class="content-footer-left">{{{>pageFooter_partial}}}</div>{{/if}}
        {{#if pageFooterRight}}<div class="content-footer-right">{{{>pageFooterRight_partial}}}</div>{{/if}}
      </footer>
      {{/if}}
    </main>

    {{#unless excludeRightSidebar}}
    {{>sidebar_right}}
    {{/unless}}
  </div>

  <div id="mobile-backdrop" class="mobile-backdrop" hidden></div>
  {{>modal_dialog}}
</body>

</html>
